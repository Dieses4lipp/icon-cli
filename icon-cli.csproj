<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- PackAsTool rejects platform TFMs (NETSDK1146); AssemblyInfo.cs marks the assembly Windows-only instead. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>icon-cli</AssemblyName>
    <RootNamespace>IconCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>icon-cli</ToolCommandName>
    <PackageId>icon-cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>Dieses4lipp</Authors>
    <Description>Recolours and applies Windows desktop shortcut icons.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>artifacts/nupkg</PackageOutputPath>
  </PropertyGroup>

  <!--
    Self-contained single-file exe for users without the SDK:
      dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true
    PackAsTool and RuntimeIdentifier are mutually exclusive (NETSDK1146), so the exe
    build switches PackAsTool off. Compression halves the bundle at a small startup cost.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <PackAsTool>false</PackAsTool>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE;README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="icon-cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
